{
	"name": "adb-plugin-template",
	"displayName": "Template Plugin",
	"version": "2.0.0",
	"description": "Starter template for ADB plugins — isolation-ready reference implementation.",
	"author": "DeadIndian",
	"license": "AGPL-3.0-only",
	"main": "index.js",
	"requiresRestart": false,
	"isolation": true,
	"manifestVersion": 2,
	"process": {
		"model": "pooled",
		"maxExecutionMs": 5000,
		"memoryMb": 128,
		"persistentReason": null
	},
	"capabilities": {
		"storage": ["own-collection"],
		"discord": ["SendMessages", "EmbedLinks", "GuildInfo"],
		"hooks": ["subscribe"]
	},
	"permissions": {
		"storage": ["own-collection"],
		"discord": ["SendMessages", "EmbedLinks", "GuildInfo"],
		"hooks": ["subscribe"],
		"network": { "outbound": [] },
		"filesystem": { "read": [], "write": [] },
		"childProcess": false,
		"nativeAddons": false
	},
	"declaredDependencies": [],
	"discordPermissions": ["SendMessages", "EmbedLinks"],
	"configSchema": {
		"type": "object",
		"properties": {
			"welcomeMessage": {
				"type": "string",
				"default": "Hello from the template plugin!",
				"description": "Message the /example command echoes when given no text"
			}
		}
	}
}
